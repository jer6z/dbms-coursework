-- Clean up if resetting
DROP TABLE IF EXISTS SecurityAlerts CASCADE;
DROP TABLE IF EXISTS SystemLogs CASCADE;
DROP TABLE IF EXISTS DetectionRules CASCADE;
DROP TABLE IF EXISTS Users CASCADE;

-- Create Core Tables
CREATE TABLE Users (
    user_id SERIAL PRIMARY KEY, 
    username VARCHAR(50) UNIQUE NOT NULL, 
    role VARCHAR(30) NOT NULL, 
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE SystemLogs (
    log_id SERIAL PRIMARY KEY, 
    user_id INT REFERENCES Users(user_id), 
    event_type VARCHAR(50) NOT NULL, 
    status VARCHAR(20) NOT NULL, 
    query_text TEXT, 
    ip_address VARCHAR(45), 
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE DetectionRules (
    rule_id SERIAL PRIMARY KEY, 
    rule_name VARCHAR(100) NOT NULL, 
    threshold_value INT NOT NULL, 
    time_window_seconds INT NOT NULL, 
    is_active BOOLEAN DEFAULT TRUE
);

CREATE TABLE SecurityAlerts (
    alert_id SERIAL PRIMARY KEY, 
    log_id INT REFERENCES SystemLogs(log_id), 
    rule_id INT REFERENCES DetectionRules(rule_id), 
    alert_message TEXT NOT NULL, 
    severity VARCHAR(20) NOT NULL, 
    triggered_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Documentation Comments
COMMENT ON TABLE Users is 'Stores system user accounts and their assigned roles for the database audit logging project.';
COMMENT ON TABLE SystemLogs is 'Stores raw system event logs captured during database operations.';
COMMENT ON TABLE DetectionRules is 'Stores intrusion detection rules and threshold parameters defined for anomaly detection.';
COMMENT ON TABLE SecurityAlerts is 'Stores security alerts generated when system logs violate detection rules.';

COMMENT ON COLUMN Users.user_id is 'Primary key for the user account.';
COMMENT ON COLUMN Users.username is 'Unique username identifier.';
COMMENT ON COLUMN Users.role is 'Assigned security role or access level of the user.';
COMMENT ON COLUMN Users.created_at is 'Timestamp when the user account was created.';

COMMENT ON COLUMN SystemLogs.log_id is 'Primary key for the individual log entry.';
COMMENT ON COLUMN SystemLogs.user_id is 'Foreign key linking the log to the user who performed the action.';
COMMENT ON COLUMN SystemLogs.event_type is 'The category of action performed (e.g., LOGIN, QUERY, EXECUTE).';
COMMENT ON COLUMN SystemLogs.status is 'Outcome of the event (e.g., SUCCESS, FAILURE).';
COMMENT ON COLUMN SystemLogs.query_text is 'The raw text of the query or session detail logged.';
COMMENT ON COLUMN SystemLogs.ip_address is 'The source IP address from which the action originated.';
COMMENT ON COLUMN SystemLogs.timestamp is 'Timestamp when the system log event occurred.';

COMMENT ON COLUMN DetectionRules.rule_id is 'Primary key for the detection rule.';
COMMENT ON COLUMN DetectionRules.rule_name is 'Descriptive name of the intrusion detection rule.';
COMMENT ON COLUMN DetectionRules.threshold_value is 'Numeric limit or threshold required to trigger the rule.';
COMMENT ON COLUMN DetectionRules.time_window_seconds is 'Time interval window in seconds over which the threshold is evaluated.';
COMMENT ON COLUMN DetectionRules.is_active is 'Boolean flag indicating whether the rule is currently active.';

COMMENT ON COLUMN SecurityAlerts.alert_id is 'Primary key for the generated security alert.';
COMMENT ON COLUMN SecurityAlerts.log_id is 'Foreign key linking the alert to the specific violating system log.';
COMMENT ON COLUMN SecurityAlerts.rule_id is 'Foreign key linking the alert to the detection rule that was violated.';
COMMENT ON COLUMN SecurityAlerts.alert_message is 'Description message detailing why the alert was triggered.';
COMMENT ON COLUMN SecurityAlerts.severity is 'Severity classification of the security alert (e.g., LOW, MEDIUM, HIGH, CRITICAL).';
COMMENT ON COLUMN SecurityAlerts.triggered_at is 'Timestamp when the security alert was generated.';

